#!/usr/bin/env python3
"""Export the canonical standalone Omarchy theme tree."""
import argparse
import json
import os
import shutil
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "packaging/theme/manifest.json"
DENIED = {"alacritty.toml", "foot.ini", "ghostty.conf", "kitty.conf", "vscode.json"}


def copy_entry(source: Path, target: Path) -> None:
    if source.is_symlink():
        raise SystemExit(f"refusing symlink in theme export: {source}")
    if source.is_dir():
        shutil.copytree(source, target)
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)


def validate(tree: Path) -> None:
    for path in tree.rglob("*"):
        if path.is_symlink():
            raise SystemExit(f"theme export contains symlink: {path}")
        if path.is_file() and (path.name in DENIED or path.suffix == ".lua"):
            raise SystemExit(f"theme export contains Omarchy-denied file: {path.name}")
        if path.is_file() and path.stat().st_mode & 0o111:
            raise SystemExit(f"theme export contains executable file: {path}")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("destination", nargs="?", default=str(ROOT / "build/omarchy-evangelion-theme"))
    args = parser.parse_args()
    destination = Path(args.destination).resolve()
    if destination == ROOT or ROOT in destination.parents and destination.name in {"theme", "packaging", "media"}:
        raise SystemExit("refusing to replace a canonical source directory")

    manifest = json.loads(MANIFEST.read_text())
    destination.parent.mkdir(parents=True, exist_ok=True)
    scratch = Path(tempfile.mkdtemp(prefix=".evangelion-theme-", dir=destination.parent))
    try:
        for source_name, target_name in manifest["files"].items():
            source = ROOT / source_name
            if not source.exists():
                raise SystemExit(f"missing theme source: {source_name}")
            copy_entry(source, scratch / target_name)
        (scratch / ".distribution.json").write_text(json.dumps({
            "schema_version": 1,
            "name": manifest["name"],
            "derived_from_suite": manifest["derived_from_suite"],
            "suite_homepage": manifest["suite_homepage"],
            "source_manifest": "packaging/theme/manifest.json"
        }, indent=2) + "\n")
        validate(scratch)
        if destination.exists():
            shutil.rmtree(destination)
        os.replace(scratch, destination)
    finally:
        if scratch.exists():
            shutil.rmtree(scratch)
    print(destination)


if __name__ == "__main__":
    main()
