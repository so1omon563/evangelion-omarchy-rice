{
  "schema_version": 1,
  "baseline": "v1.3.1",
  "tiers": {
    "theme": {
      "channel": "omarchy-theme-catalog-or-git",
      "payload": ["theme/**", "ASSETS_LICENSE.md", "LICENSE"],
      "owns_user_config": false,
      "activation": "explicit-theme-selection",
      "rollback": "restore-previous-theme-payload",
      "removal": "remove-named-theme-only-when-inactive",
      "versioning": "independent-semver-with-derived-suite-version"
    },
    "suite": {
      "channel": "github-release",
      "payload": ["repository-release-archive"],
      "owns_user_config": "manifest-listed-paths-only",
      "activation": "explicit-transactional-install",
      "rollback": "exact-manifest-snapshot",
      "removal": "manifest-driven-restore-and-remove",
      "versioning": "immutable-semver-git-tag"
    },
    "arch": {
      "channel": "aur-or-arch-source-package",
      "payload": ["/usr/share/evangelion-rice/**", "/usr/bin/evangelion-rice-*"],
      "owns_user_config": false,
      "activation": "separate-explicit-per-user-command",
      "rollback": "pacman-system-version-plus-user-transaction",
      "removal": "pacman-payload-removal-and-separate-user-deactivation",
      "versioning": "pkgver-maps-immutable-suite-tag"
    }
  },
  "owners": {
    "package_manager": ["/usr/share/evangelion-rice/**", "/usr/bin/evangelion-rice-*"],
    "suite_transaction": ["manifest.tsv exact targets"],
    "user": ["preserved preferences", "unrelated paths", "unselected tier content"]
  },
  "internal_plugins": {
    "distribution": "suite-only",
    "standalone_advertising": false,
    "standalone_installation": false,
    "runtime_publication": false
  },
  "channel_conflicts": {
    "theme-to-suite": {
      "path": "~/.config/omarchy/themes/evangelion",
      "policy": "refuse-git-owned-tree-until-user-switches-and-removes-theme"
    },
    "git-suite-to-release-suite": {
      "policy": "same-transaction-owner-upgrade"
    },
    "release-suite-to-arch-suite": {
      "policy": "deactivate-user-transaction-before-switching-system-owner"
    }
  },
  "optional_runtime": {
    "contract": "magi.optional-runtime",
    "version": "1.0.0",
    "decision": "intentionally-avoided-as-separate-package",
    "specification": "MAGI_RUNTIME.md",
    "machine_contract": "magi-runtime-contract.json",
    "plugin_local_fallbacks_required": true,
    "hidden_installation": false
  },
  "policies": {
    "silent_home_overwrite": "prohibited",
    "system_install_mutates_home": false,
    "preview_before_first_mutation": true,
    "optional_dependencies_degrade_cleanly": true,
    "community_hardware_reports": "optional-post-release",
    "artwork_commercial_distribution": false
  },
  "licenses": {
    "software_and_configuration": "MIT",
    "generated_wallpapers": "CC-BY-NC-4.0-subject-to-third-party-rights",
    "third_party_marks": "not-granted"
  }
}
