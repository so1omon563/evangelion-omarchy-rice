#!/usr/bin/env python3

import math
import os
import shutil
import struct
import subprocess
import sys
import time
from pathlib import Path

RATE = 48_000
SYNTH_LEVEL = 0.55
STREAM_VOLUME = 0.16
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy"
DISABLED = STATE_DIR / "evangelion-sounds.disabled"
runtime_candidate = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
RUNTIME = runtime_candidate if runtime_candidate.is_dir() else Path("/tmp")

CUES = {
    "lock": ([(520, 0.08), (392, 0.10), (294, 0.12)], 1.5),
    "unlock": ([(392, 0.07), (523, 0.07), (659, 0.13)], 1.5),
    "power": ([(220, 0.08), (277, 0.12)], 1.0),
    "critical": ([(660, 0.09), (440, 0.09), (660, 0.09), (440, 0.14)], 60.0),
    "nominal": ([(392, 0.07), (494, 0.07), (587, 0.15)], 5.0),
}


def samples(notes):
    result = bytearray()
    phase = 0.0
    for frequency, duration in notes:
        count = int(RATE * duration)
        edge = max(1, int(RATE * min(0.012, duration / 4)))
        for index in range(count):
            envelope = min(1.0, index / edge, (count - index - 1) / edge)
            fundamental = math.sin(phase)
            harmonic = 0.16 * math.sin(phase * 2)
            value = int(32767 * SYNTH_LEVEL * envelope * (fundamental + harmonic))
            result.extend(struct.pack("<h", max(-32768, min(32767, value))))
            phase += 2 * math.pi * frequency / RATE
        result.extend(b"\0\0" * int(RATE * 0.018))
    return bytes(result)


def rate_limited(name, seconds):
    marker = RUNTIME / f"magi-sound-{name}"
    try:
        if time.time() - marker.stat().st_mtime < seconds:
            return True
    except OSError:
        pass
    try:
        marker.touch()
    except OSError:
        return False
    return False


def play(name, force=False):
    if DISABLED.exists() and not force:
        return 0
    if name not in CUES or not shutil.which("pw-cat"):
        return 0
    notes, limit = CUES[name]
    if not force and rate_limited(name, limit):
        return 0
    try:
        subprocess.run(
            ["pw-cat", "--playback", "--raw", "--rate", str(RATE),
             "--channels", "1", "--format", "s16", "--volume", str(STREAM_VOLUME), "-"],
            input=samples(notes), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            check=False, timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass
    return 0


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    if command == "enable":
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        DISABLED.unlink(missing_ok=True)
        print("Evangelion sound cues enabled")
    elif command == "disable":
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        DISABLED.touch()
        print("Evangelion sound cues disabled")
    elif command == "status":
        print("disabled" if DISABLED.exists() else "enabled")
    elif command == "test":
        for cue in CUES:
            play(cue, force=True)
            time.sleep(0.12)
    elif command in CUES:
        return play(command)
    else:
        print("Usage: magi-sound [lock|unlock|power|critical|nominal|test|enable|disable|status]", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
