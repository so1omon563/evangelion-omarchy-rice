#!/usr/bin/env bash

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
mode_file="$state_dir/evangelion-screensaver-mode"

case "${1:-status}" in
  evangelion)
    mkdir -p "$state_dir"
    printf '%s\n' evangelion >"$mode_file"
    echo "Evangelion screensaver enabled"
    ;;
  default)
    mkdir -p "$state_dir"
    printf '%s\n' default >"$mode_file"
    echo "Default Omarchy screensaver restored"
    ;;
  status)
    [[ -r $mode_file ]] && cat "$mode_file" || echo evangelion
    ;;
  *)
    echo "Usage: magi-screensaver-mode [evangelion|default|status]" >&2
    exit 2
    ;;
esac
