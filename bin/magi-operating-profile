#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/evangelion-rice/operating-profile"
config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/operating-profiles.json"
shell_config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.toml"
mode_file="$state_dir/mode"
active_file="$state_dir/active"
mobile_wallpaper_file="$state_dir/mobile-wallpaper"
transaction_dir="$state_dir/last-transaction"
mkdir -p "$state_dir"

default_config='{"docked":{"power_profile":"performance","bar_size":30,"audio_target":"external","wallpaper":"3-magi-tokyo3.png","display_layout":"extend-right"},"mobile":{"power_profile":"balanced","bar_size":26,"audio_target":"internal","wallpaper":"restore","display_layout":"internal"}}'

read_config() {
  if [[ -r $config ]] && jq -e '(.docked|type)=="object" and (.mobile|type)=="object"' "$config" >/dev/null 2>&1; then
    cat "$config"
  else
    printf '%s\n' "$default_config"
  fi
}

mode() {
  local value=auto
  [[ -r $mode_file ]] && read -r value < "$mode_file"
  case $value in auto|docked|mobile) printf '%s\n' "$value" ;; *) printf '%s\n' auto ;; esac
}

monitor_json() {
  local value
  value=$(hyprctl monitors -j 2>/dev/null || true)
  if jq -e 'type == "array"' >/dev/null 2>&1 <<< "$value"; then
    printf '%s\n' "$value"
  else
    printf '[]\n'
  fi
}
is_internal() { [[ $1 == eDP-* || $1 == LVDS-* || $1 == DSI-* ]]; }

detected_profile() {
  local output
  while IFS= read -r output; do
    if ! is_internal "$output"; then printf '%s\n' docked; return; fi
  done < <(monitor_json | jq -r '.[].name')
  printf '%s\n' mobile
}

effective_profile() {
  local selected
  selected=$(mode)
  [[ $selected == auto ]] && detected_profile || printf '%s\n' "$selected"
}

profile_value() { read_config | jq -r --arg p "$1" --arg k "$2" '.[$p][$k] // empty'; }

set_bar_size() {
  local size=$1 source=/dev/null tmp
  [[ $size =~ ^[0-9]+$ ]] || return 0
  [[ -r $shell_config ]] && source=$shell_config
  tmp=$(mktemp "$state_dir/shell.XXXXXX")
  awk -v size="$size" '
    BEGIN { in_bar=0; saw_bar=0 }
    /^\[bar\][[:space:]]*$/ { print; print "size-horizontal = " size; print "size-vertical = " size; in_bar=1; saw_bar=1; next }
    /^\[/ { in_bar=0 }
    in_bar && /^[[:space:]]*(size-horizontal|size-vertical)[[:space:]]*=/ { next }
    { print }
    END { if (!saw_bar) { print ""; print "[bar]"; print "size-horizontal = " size; print "size-vertical = " size } }
  ' "$source" > "$tmp"
  install -m 0644 "$tmp" "$shell_config"
  rm -f "$tmp"
}

set_power_profile() {
  local requested=$1
  command -v powerprofilesctl >/dev/null || return 0
  powerprofilesctl list 2>/dev/null | sed -n 's/^\**[[:space:]]*\([^:]*\):.*/\1/p' | grep -Fxq "$requested" || return 0
  [[ $(powerprofilesctl get 2>/dev/null || true) == "$requested" ]] || powerprofilesctl set "$requested"
}

set_audio_target() {
  local target=$1 sinks chosen=""
  command -v pactl >/dev/null || return 0
  sinks=$(pactl -f json list sinks 2>/dev/null) || return 0
  case $target in
    internal) chosen=$(jq -r '[.[] | select(.properties["device.form_factor"]=="internal" or .properties["device.bus"]=="pci")][0].name // empty' <<< "$sinks") ;;
    external) chosen=$(jq -r '[.[] | select(.properties["device.form_factor"]!="internal" and .properties["device.bus"]!="pci")][0].name // empty' <<< "$sinks") ;;
    keep|"") return 0 ;;
    *) chosen=$target ;;
  esac
  [[ -z $chosen ]] || pactl set-default-sink "$chosen" || return 1
  return 0
}

current_wallpaper() { readlink -f "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/background" 2>/dev/null || true; }

set_wallpaper() {
  local profile=$1 requested=$2 current target=""
  current=$(current_wallpaper)
  if [[ $profile == docked && -n $current && ! -e $mobile_wallpaper_file ]]; then
    printf '%s\n' "$current" > "$mobile_wallpaper_file"
  fi
  case $requested in
    keep|"") return 0 ;;
    restore)
      [[ -r $mobile_wallpaper_file ]] && read -r target < "$mobile_wallpaper_file"
      ;;
    /*) target=$requested ;;
    *) target="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/backgrounds/$requested" ;;
  esac
  if [[ -f $target && $target != "$current" ]]; then omarchy-theme-bg-set "$target" >/dev/null || return 1; fi
  [[ $profile == mobile ]] && rm -f "$mobile_wallpaper_file"
  return 0
}

arrange_displays() {
  local profile=$1 layout=$2 internal external width
  internal=$(monitor_json | jq -r '[.[]|select(.name|test("^(eDP|LVDS|DSI)-"))][0].name // empty')
  external=$(monitor_json | jq -r '[.[]|select(.name|test("^(eDP|LVDS|DSI)-")|not)][0].name // empty')
  [[ $profile == docked && $layout == extend-right && -n $internal && -n $external ]] || return 0
  width=$(monitor_json | jq -r --arg name "$internal" '.[]|select(.name==$name)|(.width/.scale|floor)')
  hyprctl eval "hl.monitor({ output = \"$internal\", mode = \"preferred\", position = \"0x0\", scale = 1 })" >/dev/null || return 1
  hyprctl eval "hl.monitor({ output = \"$external\", mode = \"preferred\", position = \"${width}x0\", scale = 1 })" >/dev/null || return 1
}

rescue_windows() {
  local monitors clients target address monitor workspace valid
  monitors=$(monitor_json); clients=$(hyprctl clients -j 2>/dev/null || printf '[]\n')
  target=$(jq -r '[.[]|select(.name|test("^(eDP|LVDS|DSI)-"))][0].name // .[0].name // empty' <<< "$monitors")
  [[ -n $target ]] || return 0
  while IFS=$'\t' read -r address monitor workspace; do
    [[ -n $address && $workspace =~ ^[1-9][0-9]*$ ]] || continue
    valid=$(jq -r --argjson id "$monitor" 'any(.[]; .id==$id)' <<< "$monitors")
    [[ $valid == true ]] && continue
    hyprctl eval "hl.dsp.window.move({ monitor = \"$target\", follow = false, window = \"address:$address\" })" >/dev/null || true
  done < <(jq -r '.[]|[.address,(.monitor|tostring),(.workspace.id|tostring)]|@tsv' <<< "$clients")
}

apply_profile() {
  local profile cfg power bar audio wallpaper layout prior
  profile=${1:-$(effective_profile)}; cfg=$(read_config); prior=$(cat "$active_file" 2>/dev/null || true)
  omarchy-shell -q mode-transition show "$profile" entering "Synchronizing display, power, audio, and interface" >/dev/null 2>&1 || true
  power=$(jq -r --arg p "$profile" '.[$p].power_profile // empty' <<< "$cfg")
  bar=$(jq -r --arg p "$profile" '.[$p].bar_size // empty' <<< "$cfg")
  audio=$(jq -r --arg p "$profile" '.[$p].audio_target // empty' <<< "$cfg")
  wallpaper=$(jq -r --arg p "$profile" '.[$p].wallpaper // empty' <<< "$cfg")
  layout=$(jq -r --arg p "$profile" '.[$p].display_layout // empty' <<< "$cfg")
  arrange_displays "$profile" "$layout"
  rescue_windows
  set_power_profile "$power"
  set_audio_target "$audio"
  set_bar_size "$bar"
  if [[ $prior != "$profile" ]]; then set_wallpaper "$profile" "$wallpaper"; fi
  printf '%s\n' "$profile" > "$active_file"
  [[ $prior == "$profile" ]] || omarchy-notification-send -u low -g '󰍹' "OPERATING PROFILE // ${profile^^}" "Power, display, audio, and interface synchronized" 2>/dev/null || true
  omarchy-shell -q mode-transition show "$profile" active "Operating profile synchronized" >/dev/null 2>&1 || true
  printf '%s\n' "$profile"
}

capture_transaction() {
  local profile=$1 power audio wallpaper
  rm -rf -- "$transaction_dir"
  mkdir -p "$transaction_dir"
  [[ -r $shell_config ]] && cp -- "$shell_config" "$transaction_dir/shell.toml"
  [[ -r $active_file ]] && cp -- "$active_file" "$transaction_dir/active"
  [[ -r $mobile_wallpaper_file ]] && cp -- "$mobile_wallpaper_file" "$transaction_dir/mobile-wallpaper"
  power=$(command -v powerprofilesctl >/dev/null && powerprofilesctl get 2>/dev/null || true)
  audio=$(command -v pactl >/dev/null && pactl get-default-sink 2>/dev/null || true)
  wallpaper=$(current_wallpaper)
  monitor_json > "$transaction_dir/monitors.json"
  jq -n --arg target "$profile" --arg power "$power" --arg audio "$audio" --arg wallpaper "$wallpaper" \
    '{schema_version:1,target:$target,power_profile:$power,audio_sink:$audio,wallpaper:$wallpaper}' > "$transaction_dir/state.json"
  chmod 600 "$transaction_dir/state.json" "$transaction_dir/monitors.json"
}

restore_transaction() {
  local snapshot="$transaction_dir/state.json" power audio wallpaper name width height x y scale
  [[ -r $snapshot ]] || { echo 'No operating-profile transaction is available to undo.' >&2; return 2; }
  [[ -r $transaction_dir/shell.toml ]] && install -m 0644 "$transaction_dir/shell.toml" "$shell_config"
  if [[ -r $transaction_dir/active ]]; then install -m 0600 "$transaction_dir/active" "$active_file"; else rm -f -- "$active_file"; fi
  if [[ -r $transaction_dir/mobile-wallpaper ]]; then install -m 0600 "$transaction_dir/mobile-wallpaper" "$mobile_wallpaper_file"; else rm -f -- "$mobile_wallpaper_file"; fi
  power=$(jq -r '.power_profile // empty' "$snapshot")
  audio=$(jq -r '.audio_sink // empty' "$snapshot")
  wallpaper=$(jq -r '.wallpaper // empty' "$snapshot")
  [[ -z $power ]] || ! command -v powerprofilesctl >/dev/null || powerprofilesctl set "$power" >/dev/null 2>&1 || true
  [[ -z $audio ]] || ! command -v pactl >/dev/null || pactl set-default-sink "$audio" >/dev/null 2>&1 || true
  [[ ! -f $wallpaper ]] || omarchy-theme-bg-set "$wallpaper" >/dev/null 2>&1 || true
  if [[ -r $transaction_dir/monitors.json ]]; then
    while IFS=$'\t' read -r name width height x y scale; do
      [[ -n $name ]] || continue
      hyprctl eval "hl.monitor({ output = \"$name\", mode = \"${width}x${height}\", position = \"${x}x${y}\", scale = $scale })" >/dev/null 2>&1 || true
    done < <(jq -r '.[]|[.name,(.width|tostring),(.height|tostring),(.x|tostring),(.y|tostring),(.scale|tostring)]|@tsv' "$transaction_dir/monitors.json")
  fi
}

context_transaction() {
  local profile=$1 cfg prior power bar audio wallpaper layout failed=""
  [[ $profile == docked || $profile == mobile ]] || { echo '{"status":"failed","failed_subsystem":"validation"}'; return 2; }
  [[ $(mode) == auto ]] || { echo '{"status":"held","failed_subsystem":"manual-profile-selection"}'; return 3; }
  cfg=$(read_config); prior=$(cat "$active_file" 2>/dev/null || true)
  capture_transaction "$profile"
  power=$(jq -r --arg p "$profile" '.[$p].power_profile // empty' <<< "$cfg")
  bar=$(jq -r --arg p "$profile" '.[$p].bar_size // empty' <<< "$cfg")
  audio=$(jq -r --arg p "$profile" '.[$p].audio_target // empty' <<< "$cfg")
  wallpaper=$(jq -r --arg p "$profile" '.[$p].wallpaper // empty' <<< "$cfg")
  layout=$(jq -r --arg p "$profile" '.[$p].display_layout // empty' <<< "$cfg")
  omarchy-shell -q mode-transition show "$profile" entering "Context automation transaction" >/dev/null 2>&1 || true
  arrange_displays "$profile" "$layout" || failed=displays
  [[ -n $failed ]] || rescue_windows || failed=windows
  [[ -n $failed ]] || set_power_profile "$power" || failed=power
  [[ -n $failed ]] || set_audio_target "$audio" || failed=audio
  [[ -n $failed ]] || set_bar_size "$bar" || failed=interface
  if [[ -z $failed && $prior != "$profile" ]]; then set_wallpaper "$profile" "$wallpaper" || failed=wallpaper; fi
  if [[ -n $failed ]]; then
    restore_transaction || true
    omarchy-shell -q mode-transition show "$profile" aborted "Rollback complete: $failed failed" >/dev/null 2>&1 || true
    jq -cn --arg subsystem "$failed" '{status:"failed",rolled_back:true,failed_subsystem:$subsystem}'
    return 1
  fi
  printf '%s\n' "$profile" > "$active_file"
  omarchy-shell -q mode-transition show "$profile" active "Context-selected profile synchronized" >/dev/null 2>&1 || true
  omarchy-notification-send -u low -g '󰑐' "CONTEXT AUTOMATION // ${profile^^}" "Profile synchronized · Undo available" 2>/dev/null || true
  jq -cn --arg profile "$profile" '{status:"applied",profile:$profile,undo_available:true}'
}

show_status() {
  printf 'mode=%s\ndetected=%s\neffective=%s\nactive=%s\n' "$(mode)" "$(detected_profile)" "$(effective_profile)" "$(cat "$active_file" 2>/dev/null || echo none)"
}

show_plan() {
  local profile; profile=$(effective_profile)
  printf 'mode=%s\ndetected=%s\neffective=%s\n' "$(mode)" "$(detected_profile)" "$profile"
  read_config | jq --arg p "$profile" '.[$p]'
}

case ${1:-apply} in
  apply) apply_profile ;;
  context)
    [[ ${2:-} == docked || ${2:-} == mobile ]] || { echo 'Usage: magi-operating-profile context {docked|mobile}' >&2; exit 2; }
    context_transaction "$2"
    ;;
  undo)
    restore_transaction
    omarchy-shell -q mode-transition show "$(cat "$active_file" 2>/dev/null || echo mobile)" active "Automated profile change undone" >/dev/null 2>&1 || true
    printf '{"status":"undone"}\n'
    ;;
  auto|docked|mobile)
    printf '%s\n' "$1" > "$mode_file"
    apply_profile >/dev/null
    show_status
    ;;
  status) show_status ;;
  plan) show_plan ;;
  *) echo 'Usage: magi-operating-profile {apply|auto|docked|mobile|status|plan|context PROFILE|undo}' >&2; exit 2 ;;
esac
