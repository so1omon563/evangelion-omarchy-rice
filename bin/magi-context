#!/usr/bin/env python3
"""Publish and explain the local MAGI context contract without collecting data."""

import fcntl
import json
import os
import sys
import tempfile
import time
from copy import deepcopy
from datetime import datetime, timezone
from pathlib import Path

for library in (Path(__file__).resolve().parents[1] / "lib",
                Path.home() / ".local/lib/evangelion-rice"):
    if library.is_dir():
        sys.path.insert(0, str(library))

from magi_context_collectors import collect_all
from magi_context_policy import POLICY_VERSION, evaluate

CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
CONFIG = CONFIG_HOME / "omarchy/evangelion.json"
STATE_DIR = STATE_HOME / "evangelion-rice/context"
STATE = STATE_DIR / "state.json"
REQUESTS = STATE_DIR / "requests.json"
LOCK = STATE_DIR / "controller.lock"

COLLECTORS = ("power", "thermal", "displays", "devices", "connectivity",
              "media", "time", "operating_profile")
AVAILABILITY = ("unknown", "available", "unavailable", "disabled")
FRESHNESS = ("unknown", "fresh", "stale", "disabled")
SURFACE_FACTS = ("battery_percent", "connectivity", "display_mode", "media_state",
                 "operating_profile", "power_source", "profile_selection",
                 "temperature_c", "thermal_pressure", "time_band", "weekend")
DEFAULT_CONTEXT = {
    "enabled": True,
    "automation_enabled": False,
    "decorative_enabled": True,
    "automation_rules": {"environment_profile": False},
    "max_age_seconds": 300,
    "collectors": {name: True for name in COLLECTORS},
}


def utc_now():
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def read_object(path, fallback, strict=False):
    try:
        value = json.loads(path.read_text())
    except FileNotFoundError:
        return deepcopy(fallback)
    except (OSError, json.JSONDecodeError) as error:
        if strict:
            raise ValueError(f"Cannot safely update {path}: {error}") from error
        return deepcopy(fallback)
    if not isinstance(value, dict):
        if strict:
            raise ValueError(f"Cannot safely update {path}: root must be a JSON object")
        return deepcopy(fallback)
    return value


def resolved_config(strict=False):
    root = read_object(CONFIG, {}, strict=strict)
    supplied = root.get("context", {})
    if not isinstance(supplied, dict):
        if strict:
            raise ValueError(f"Cannot safely update {CONFIG}: context must be a JSON object")
        supplied = {}
    result = deepcopy(DEFAULT_CONTEXT)
    for key in ("enabled", "automation_enabled", "decorative_enabled", "max_age_seconds"):
        if key in supplied:
            result[key] = supplied[key]
    configured_collectors = supplied.get("collectors", {})
    if isinstance(configured_collectors, dict):
        for name in COLLECTORS:
            if name in configured_collectors:
                result["collectors"][name] = configured_collectors[name]
    configured_rules = supplied.get("automation_rules", {})
    if isinstance(configured_rules, dict) and "environment_profile" in configured_rules:
        result["automation_rules"]["environment_profile"] = configured_rules["environment_profile"]

    for key in ("enabled", "automation_enabled", "decorative_enabled"):
        if not isinstance(result[key], bool):
            raise ValueError(f"context.{key} must be true or false")
    if not isinstance(result["max_age_seconds"], int) or not 1 <= result["max_age_seconds"] <= 86400:
        raise ValueError("context.max_age_seconds must be an integer from 1 to 86400")
    if not all(isinstance(value, bool) for value in result["collectors"].values()):
        raise ValueError("context.collectors values must be true or false")
    if not all(isinstance(value, bool) for value in result["automation_rules"].values()):
        raise ValueError("context.automation_rules values must be true or false")
    return root, result


def locked():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    stream = LOCK.open("a+")
    os.chmod(LOCK, 0o600)
    fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
    return stream


def reserve_request():
    stream = locked()
    try:
        previous = read_object(REQUESTS, {"latest_request_id": 0}).get("latest_request_id", 0)
        request_id = previous + 1 if isinstance(previous, int) and previous >= 0 else 1
        atomic_json(REQUESTS, {"schema_version": 1, "latest_request_id": request_id,
                               "requested_at": utc_now()})
        return request_id
    finally:
        stream.close()


def signal_contract(enabled):
    availability = "unknown" if enabled else "disabled"
    freshness = "unknown" if enabled else "disabled"
    return {"availability": availability, "freshness": {"status": freshness,
            "observed_at": None, "expires_at": None}, "value": None,
            "reason": "awaiting-observation" if enabled else "disabled"}


def parse_timestamp(value):
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, TypeError, ValueError):
        return None


def observed_signal(observation, previous, max_age, now):
    if observation and observation.get("available"):
        expires = now.timestamp() + max_age
        return {"availability": "available", "freshness": {"status": "fresh",
                "observed_at": now.isoformat().replace("+00:00", "Z"),
                "expires_at": datetime.fromtimestamp(expires, timezone.utc).isoformat().replace("+00:00", "Z")},
                "value": observation["value"], "reason": "observed"}
    old_time = parse_timestamp(previous.get("freshness", {}).get("observed_at")) if isinstance(previous, dict) else None
    if old_time and previous.get("availability") == "available":
        age = max(0, (now - old_time).total_seconds())
        freshness = "stale" if age > max_age else "fresh"
        carried = deepcopy(previous)
        carried["freshness"]["status"] = freshness
        carried["reason"] = "cached-observation" if freshness == "fresh" else "stale-observation"
        return carried
    return {"availability": "unavailable", "freshness": {"status": "unknown",
            "observed_at": None, "expires_at": None}, "value": None,
            "reason": str((observation or {}).get("reason", "collector-unavailable"))[:64]}


def facts_from(signals):
    facts = {}
    mappings = {
        "power": (("power_source", "source"), ("battery_percent", "battery_percent")),
        "thermal": (("thermal_pressure", "pressure"), ("temperature_c", "temperature_c")),
        "displays": (("display_mode", "docked"),),
        "connectivity": (("connectivity", "state"),),
        "media": (("media_state", "state"),),
        "time": (("time_band", "band"), ("weekend", "weekend")),
        "operating_profile": (("operating_profile", "active"), ("profile_selection", "selected")),
    }
    for signal, pairs in mappings.items():
        item = signals.get(signal, {})
        if item.get("availability") != "available":
            continue
        value = item.get("value", {})
        for fact, key in pairs:
            if key in value and value[key] is not None:
                facts[fact] = "docked" if fact == "display_mode" and value[key] else "mobile" if fact == "display_mode" else value[key]
    device = signals.get("devices", {})
    if device.get("availability") == "available":
        facts["device_counts"] = device["value"]
    return facts


def build_state(request_id, generation=0, observations=None, previous=None):
    _, config = resolved_config()
    controller_enabled = config["enabled"]
    enabled_collectors = [name for name in COLLECTORS if config["collectors"][name]]
    observations = observations or {}
    previous_signals = (previous or {}).get("signals", {})
    now = datetime.now(timezone.utc)
    signals = {}
    for name in COLLECTORS:
        enabled = controller_enabled and config["collectors"][name]
        signals[name] = (observed_signal(observations.get(name), previous_signals.get(name, {}),
                                         config["max_age_seconds"], now)
                         if enabled else signal_contract(False))
    facts = facts_from(signals)
    available = sum(item["availability"] == "available" for item in signals.values())
    stale = [name for name, item in signals.items() if item["freshness"]["status"] == "stale"]
    unavailable = [name for name, item in signals.items() if item["availability"] == "unavailable"]
    if not controller_enabled:
        status, reason, summary = "disabled", "context-disabled", "Context processing is disabled"
    elif not enabled_collectors:
        status, reason, summary = "unavailable", "no-collectors-enabled", "No context collectors are enabled"
    elif available == 0 and observations:
        status, reason, summary = "unavailable", "collectors-unavailable", "Enabled context collectors are unavailable"
    elif available:
        status, reason, summary = "unknown", "policy-evaluating", "Local observations are ready for policy evaluation"
    else:
        status, reason, summary = "unknown", "awaiting-observations", "No local observations have been published"
    reasons = [{"code": reason, "summary": summary, "signals": []}]
    if stale:
        reasons.append({"code": "stale-observations", "summary": "Cached observations exceeded their freshness bound", "signals": stale})
    if unavailable:
        reasons.append({"code": "collectors-unavailable", "summary": "Some enabled collectors could not be observed", "signals": unavailable})
    observed_at = [item["freshness"]["observed_at"] for item in signals.values()
                   if item["freshness"]["observed_at"]]
    expires_at = [item["freshness"]["expires_at"] for item in signals.values()
                  if item["freshness"]["expires_at"]]
    derived_freshness = "disabled" if status == "disabled" else "stale" if stale else "fresh" if available else "unknown"
    policy = None
    if controller_enabled and enabled_collectors and available:
        policy = evaluate(facts, signals, previous, now.timestamp())
        status, summary = policy["status"], policy["summary"]
        reasons[0] = policy["reason"]
    recommendations = policy["recommendations"] if policy else []
    automatic_actions = []
    if config["automation_enabled"] and config["automation_rules"]["environment_profile"]:
        for item in recommendations:
            if item.get("action") == "select-operating-profile" and item.get("target") in {"docked", "mobile"}:
                automatic_actions.append({"id": item["id"], "rule": "environment_profile",
                                          "action": item["action"], "target": item["target"],
                                          "reason_code": item["reason_code"],
                                          "requires_confirmation": False})
    return {
        "schema_version": 1,
        "generation": generation,
        "request_id": request_id,
        "published_at": utc_now(),
        "controller": config,
        "contract": {"availability_values": list(AVAILABILITY),
                     "freshness_values": list(FRESHNESS),
                     "policy_version": POLICY_VERSION},
        "signals": signals,
        "facts": facts,
        "derived_state": {"status": status, "summary": summary,
                          "confidence": round(available / max(1, len(enabled_collectors)), 3),
                          "freshness": {"status": derived_freshness,
                                        "observed_at": max(observed_at) if observed_at else None,
                                        "expires_at": min(expires_at) if expires_at else None}},
        "reasons": reasons,
        "recommendations": recommendations,
        "automatic_actions": automatic_actions,
        "policy_state": policy["policy_state"] if policy else {"version": POLICY_VERSION},
    }


def publish_latest(request_id):
    delay = int(os.environ.get("MAGI_CONTEXT_TEST_DELAY_MS", "0") or 0)
    if delay > 0:
        time.sleep(min(delay, 5000) / 1000)
    _, config = resolved_config()
    enabled = [name for name in COLLECTORS if config["enabled"] and config["collectors"][name]]
    observations = collect_all(enabled) if enabled else {}
    stream = locked()
    try:
        latest = read_object(REQUESTS, {"latest_request_id": 0}).get("latest_request_id", 0)
        if latest != request_id:
            return load_state(), False
        prior_state = read_object(STATE, {})
        # An unknown schema is never policy input and cannot control the new
        # generation counter. Preserve the file on read-only status, then start
        # a clean v1 sequence only when an explicit refresh publishes it.
        if prior_state.get("schema_version") != 1:
            prior_state = {}
        previous = prior_state.get("generation", 0)
        generation = previous + 1 if isinstance(previous, int) and previous >= 0 else 1
        state = build_state(request_id, generation, observations, prior_state)
        atomic_json(STATE, state)
        return state, True
    finally:
        stream.close()


def refresh():
    return publish_latest(reserve_request())


def load_state():
    state = read_object(STATE, {})
    if state.get("schema_version") == 1:
        return state
    return build_state(0, 0)


def update_config(target, enabled):
    root, context = resolved_config(strict=True)
    if target == "context":
        context["enabled"] = enabled
    elif target == "automation":
        context["automation_enabled"] = enabled
    elif target.startswith("automation-rule:"):
        name = target.split(":", 1)[1]
        if name not in context["automation_rules"]:
            raise ValueError(f"Unknown automation rule: {name}")
        context["automation_rules"][name] = enabled
    elif target == "decorative":
        context["decorative_enabled"] = enabled
    elif target.startswith("collector:"):
        name = target.split(":", 1)[1]
        if name not in COLLECTORS:
            raise ValueError(f"Unknown collector: {name}")
        context["collectors"][name] = enabled
    else:
        raise ValueError(f"Unknown context control: {target}")
    root["context"] = context
    atomic_json(CONFIG, root)
    return refresh()[0]


def explain(state):
    derived = state["derived_state"]
    lines = [f"MAGI CONTEXT // {derived['status'].upper()}", derived["summary"],
             f"GENERATION // {state['generation']} · REQUEST // {state['request_id']}"]
    for reason in state["reasons"]:
        lines.append(f"REASON // {reason['code']} · {reason['summary']}")
        if reason.get("facts"):
            facts = " · ".join(f"{key}={value}" for key, value in sorted(reason["facts"].items()))
            lines.append(f"FACTS // {facts}")
    lines.append(f"AUTOMATION // {'ENABLED' if state['controller']['automation_enabled'] else 'DISABLED'}")
    lines.append(f"RECOMMENDATIONS // {len(state['recommendations'])}")
    for recommendation in state["recommendations"]:
        lines.append(f"RECOMMEND // {recommendation['reason_code']} · {recommendation['summary']}")
    lines.append(f"AUTOMATIC ACTIONS // {len(state.get('automatic_actions', []))}")
    return "\n".join(lines)


def surface_projection(state):
    """Return the fixed, presentation-safe subset consumed by visual surfaces."""
    derived = state.get("derived_state", {})
    controller = state.get("controller", {})
    freshness = derived.get("freshness", {}).get("status", "unknown")
    status = derived.get("status", "unknown")
    reason = state.get("reasons", [{}])[0] if state.get("reasons") else {}
    active = bool(controller.get("enabled") and controller.get("decorative_enabled")
                  and freshness == "fresh" and status not in {"unknown", "unavailable", "disabled"})
    facts = reason.get("facts", {}) if isinstance(reason.get("facts"), dict) else {}
    safe = {key: facts[key] for key in SURFACE_FACTS if key in facts
            and isinstance(facts[key], (str, int, float, bool))}
    return {
        "schema_version": 1, "active": active,
        "status": status if active else "baseline",
        "freshness": freshness, "reason_code": str(reason.get("code", "context-unavailable"))[:64],
        "label": str(derived.get("summary", ""))[:80] if active else "",
        "facts": safe if active else {},
    }


def usage():
    print("Usage: magi-context [status|surface|explain|refresh|enable|disable|automation enable|disable|automation-rule NAME enable|disable|decorative enable|disable|collector NAME enable|disable] [--json] [--compact]", file=sys.stderr)
    return 2


def main():
    args = [arg for arg in sys.argv[1:] if arg not in ("--json", "--compact")]
    json_output = "--json" in sys.argv[1:]
    compact = "--compact" in sys.argv[1:]
    command = args[0] if args else "status"
    try:
        if command in ("status", "surface", "explain"):
            state = load_state()
        elif command == "refresh":
            state, _ = refresh()
        elif command in ("enable", "disable") and len(args) == 1:
            state = update_config("context", command == "enable")
        elif command in ("automation", "decorative") and len(args) == 2 and args[1] in ("enable", "disable"):
            state = update_config(command, args[1] == "enable")
        elif command == "automation-rule" and len(args) == 3 and args[2] in ("enable", "disable"):
            state = update_config(f"automation-rule:{args[1]}", args[2] == "enable")
        elif command == "collector" and len(args) == 3 and args[2] in ("enable", "disable"):
            state = update_config(f"collector:{args[1]}", args[2] == "enable")
        else:
            return usage()

        output = surface_projection(state) if command == "surface" else state
        if json_output:
            print(json.dumps(output, separators=(",", ":"), sort_keys=True) if compact
                  else json.dumps(output, indent=2, sort_keys=True))
        elif command == "surface":
            print(output["status"])
        elif command == "explain":
            print(explain(state))
        else:
            print(state["derived_state"]["status"])
    except (ValueError, OSError) as error:
        print(error, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
