#!/usr/bin/env bash
set -u
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/evangelion-rice/update-operation"; state_file="$state_dir/state.json"; logs_dir="$state_dir/logs"; mkdir -p "$state_dir" "$logs_dir"
recovery_for(){ case $1 in keys) echo 'omarchy update keyring';;packages) echo 'omarchy update system pkgs';;migrations) echo 'omarchy migrate';;aur) echo 'omarchy update aur pkgs';;tools) echo 'omarchy update mise';;verification) echo 'omarchy update analyze logs';;*) echo 'magi-update run';;esac; }
write_state(){ local status=$1 phase=$2 code=${3:-0} recovery=${4:-} log=${5:-} tmp; tmp=$(mktemp "$state_dir/state.XXXXXX"); jq -n --arg status "$status" --arg phase "$phase" --arg recovery "$recovery" --arg log "$log" --argjson code "$code" --argjson updated "$(date +%s)" '{status:$status,phase:$phase,exit_code:$code,recovery:$recovery,log:$log,updated_at:$updated}' >"$tmp"; mv "$tmp" "$state_file"; omarchy-shell -q update-operation reload >/dev/null 2>&1||true; }
phase(){ write_state active "$1" 0 "" "${MAGI_UPDATE_LOG:-}"; }
wrap(){ local name=$1 phase_name=$2; eval "$name() { magi-update phase '$phase_name'; command /usr/bin/$name \"\$@\"; }"; export -f "$name"; }
run_update(){
  local stamp log code failed recovery; stamp=$(date +%Y%m%d-%H%M%S); log="$logs_dir/update-$stamp.log"; export MAGI_UPDATE_LOG="$log"; exec 9>"$state_dir/run.lock"; flock -n 9||{ echo 'A MAGI update is already active.' >&2;return 75;}; write_state active preflight 0 "" "$log"
  wrap omarchy-update-pkg-prune preparation; wrap omarchy-snapshot snapshot; wrap omarchy-update-dev framework; wrap omarchy-update-keyring keys; wrap omarchy-update-system-pkgs packages; wrap omarchy-migrate migrations; wrap omarchy-hook post-hooks; wrap omarchy-update-aur-pkgs aur; wrap omarchy-update-mise tools; wrap omarchy-update-orphan-pkgs cleanup; wrap omarchy-update-analyze-logs verification
  set +e; command omarchy update "$@"; code=$?; set -e; [[ -r /tmp/omarchy-update.log ]]&&cp /tmp/omarchy-update.log "$log"||: >"$log"; failed=$(jq -r '.phase//"unknown"' "$state_file" 2>/dev/null||echo unknown)
  if ((code==0));then write_state complete complete 0 "" "$log";omarchy-notification-send --app-name 'MAGI Maintenance' -g '◆' -u low -t 8000 'SYSTEM UPDATE // COMPLETE' "Full log: $log" 2>/dev/null||true;else recovery=$(recovery_for "$failed");write_state failed "$failed" "$code" "$recovery" "$log";omarchy-notification-send --app-name 'MAGI Maintenance' -g '▲' -u critical 'SYSTEM UPDATE // FAILED' "Phase: $failed · Retry: $recovery" 2>/dev/null||true;fi; return "$code"
}
case ${1:-status} in
run)shift;run_update "$@";;phase)phase "${2:-unknown}";;status)[[ -r $state_file ]]&&jq . "$state_file"||echo '{"status":"idle","phase":"none"}';;log)log=$(jq -r '.log//empty' "$state_file" 2>/dev/null);[[ -r $log ]]&&less "$log"||{ echo 'No update log available' >&2;exit 1;};;preview)case ${2:-active} in active)write_state active packages 0 "" preview;;complete)write_state complete complete 0 "" preview;;failed)write_state failed packages 1 'omarchy update system pkgs' preview;;idle)write_state idle none 0 "" "";;*)echo 'Preview must be active, complete, failed, or idle' >&2;exit 2;;esac;;*)echo 'Usage: magi-update {run [-y]|status|log|preview [active|complete|failed|idle]}' >&2;exit 2;;esac
