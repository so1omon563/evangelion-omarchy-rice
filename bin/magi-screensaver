#!/usr/bin/env python3

import json
import os
import select
import shutil
import signal
import sys
import termios
import time
import tty
from pathlib import Path

ESC = "\033["
GREEN = "38;2;156;242;58m"
PURPLE = "38;2;123;44;191m"
ORANGE = "38;2;255;107;53m"
RED = "38;2;229;20;54m"
WHITE = "38;2;238;232;255m"
DIM = "38;2;99;83;126m"

running = True


def apply_affinity_palette():
    global GREEN, PURPLE, ORANGE, RED, DIM
    path = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "evangelion-rice/affinity-active"
    try:
        profile = path.read_text().strip()
    except OSError:
        profile = "neutral"
    palettes = {
        "unit-00-prototype": ("38;2;246;199;68m", "38;2;59;167;216m", "38;2;255;138;36m", "38;2;213;32;50m", "38;2;117;104;67m"),
        "unit-00-refit": ("38;2;85;217;255m", "38;2;62;131;255m", "38;2;242;246;255m", "38;2;213;32;50m", "38;2;82;107;131m"),
        "unit-01": ("38;2;156;242;58m", "38;2;143;75;200m", "38;2;242;140;40m", "38;2;213;32;50m", "38;2;102;85;119m"),
        "unit-02": ("38;2;246;165;47m", "38;2;255;90;54m", "38;2;255;90;54m", "38;2;255;51;79m", "38;2;125;81;72m"),
    }
    GREEN, PURPLE, ORANGE, RED, DIM = palettes.get(profile, palettes["unit-01"])


def stop(*_args):
    global running
    running = False


def setting():
    path = Path.home() / ".config/omarchy/evangelion-screensaver.json"
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def center(lines, width, height):
    content = []
    top = max(1, (height - len(lines)) // 2)
    for row, (color, text) in enumerate(lines, top):
        clipped = text[: max(0, width - 4)]
        left = max(1, (width - len(clipped)) // 2)
        content.append(f"{ESC}{row};{left}H{ESC}{color}{clipped}")
    return "".join(content)


def place(row, column, color, text, width):
    if row < 1 or column < 1 or column > width:
        return ""
    clipped = text[: max(0, width - column + 1)]
    return f"{ESC}{row};{column}H{ESC}{color}{clipped}"


def hud(width, height, scene_index, scene_age, scene_seconds, phase, motion):
    if width < 54 or height < 18:
        return ""

    now = time.strftime("%Y.%m.%d // %H:%M:%S")
    scene_label = f"VISUAL FEED {scene_index + 1:02d}/04"
    progress = min(1.0, scene_age / scene_seconds)
    filled = int(progress * 18)
    bar = "━" * filled + "─" * (18 - filled)
    output = [
        place(2, 3, PURPLE, "╭─ NERV // MAGI VISUAL STANDBY", width),
        place(2, max(3, width - len(scene_label) - 2), GREEN, scene_label, width),
        place(3, 3, DIM, "│ SECURE DISPLAY CHANNEL", width),
        place(height - 2, 3, DIM, "╰─ " + bar, width),
        place(height - 2, max(3, width - len(now) - 2), WHITE, now, width),
        place(height - 1, 3, ORANGE, "INPUT DETECTED → TERMINATE VISUAL FEED", width),
        place(5, 2, PURPLE, "╎", width),
        place(height - 5, width - 1, GREEN, "╎", width),
    ]

    # One restrained sweep crosses the display; reduced-motion pins it safely.
    scan_row = height // 2 if not motion else 5 + (phase * 3) % max(1, height - 10)
    scan = "· " * max(1, (width - 8) // 2)
    output.append(place(scan_row, 5, "38;2;35;28;48m", scan, width))
    return "".join(output)


def transition(width, height, scene_index, amount):
    label = ["MAGI", "SYNC", "NERV", "UNIT-01"][scene_index]
    cells = min(24, max(8, width // 5))
    filled = min(cells, int(amount * cells))
    lines = [
        (PURPLE, "ROUTING VISUAL FEED"),
        (GREEN, "[" + "■" * filled + "·" * (cells - filled) + "]"),
        (WHITE, f"CHANNEL // {label}"),
    ]
    return center(lines, width, height)


def frame(title, subtitle, body, accent, width, height, phase, motion):
    pulse = "◆" if not motion or phase % 2 == 0 else "◇"
    rule_width = min(66, max(24, width - 10))
    lines = [
        (DIM, "┌" + "─" * rule_width + "┐"),
        (accent, f"  {pulse}  {title}"),
        (WHITE, f"     {subtitle}"),
        (DIM, "├" + "─" * rule_width + "┤"),
    ]
    lines.extend(body)
    lines.append((DIM, "└" + "─" * rule_width + "┘"))
    return center(lines, width, height)


def magi_scene(width, height, phase, motion):
    state = "CONSENSUS ACHIEVED" if phase % 3 else "RECALCULATING"
    body = [
        (GREEN, "MELCHIOR-1     ONLINE     [████████████]"),
        (GREEN, "BALTHASAR-2    ONLINE     [████████████]"),
        (GREEN, "CASPER-3       ONLINE     [████████████]"),
        (DIM, ""),
        (ORANGE, f"DECISION MATRIX  //  {state}"),
    ]
    return frame("MAGI SUPERCOMPUTER SYSTEM", "TOKYO-3 CENTRAL DOGMA", body, GREEN, width, height, phase, motion)


def sync_scene(width, height, phase, motion):
    values = [97.2, 98.1, 99.4, 98.7]
    sync = values[phase % len(values)] if motion else values[-1]
    fill = int(sync / 5)
    body = [
        (PURPLE, "EVA UNIT-01  //  ENTRY PLUG CONNECTED"),
        (WHITE, f"SYNCHRONIZATION  {sync:04.1f}%"),
        (GREEN, "[" + "█" * fill + "░" * (20 - fill) + "]"),
        (DIM, "A10 NERVE LINK        STABLE"),
        (DIM, "LCL PRESSURE          NOMINAL"),
    ]
    return frame("SYNCHRONIZATION TELEMETRY", "PILOT SIGNAL VERIFIED", body, PURPLE, width, height, phase, motion)


def warning_scene(width, height, phase, motion):
    accent = RED if not motion or phase % 2 == 0 else ORANGE
    body = [
        (accent, "        N  E  R  V"),
        (WHITE, "GEHIRN ARTIFICIAL EVOLUTION LABORATORY"),
        (DIM, "RESTRICTED AREA  //  LEVEL EEE"),
        (ORANGE, "SECURITY PROTOCOLS ACTIVE"),
    ]
    return frame("NERV COMMAND AUTHORITY", "UNAUTHORIZED ACCESS PROHIBITED", body, accent, width, height, phase, motion)


def unit_scene(width, height, phase, motion):
    eye = "◉" if not motion or phase % 3 else "●"
    body = [
        (PURPLE, "              ╱╲"),
        (PURPLE, f"          ╱╲╱ {eye}╲╱╲"),
        (GREEN, "        ╱╱  ╲██╱  ╲╲"),
        (PURPLE, "       ╱╱  ╱████╲  ╲╲"),
        (GREEN, "          ╱╱  ╲╲"),
        (DIM, ""),
        (ORANGE, "UNIT-01  //  RESTRAINTS SECURED"),
    ]
    return frame("EVANGELION TEST TYPE", "STANDBY CONFIGURATION", body, PURPLE, width, height, phase, motion)


def main():
    apply_affinity_palette()
    config = setting()
    reduced = bool(config.get("reduced_motion", False)) or "--static" in sys.argv
    scene_seconds = max(8, int(config.get("scene_seconds", 12)))
    scenes = [magi_scene, sync_scene, warning_scene, unit_scene]
    original = termios.tcgetattr(sys.stdin.fileno())
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    tty.setcbreak(sys.stdin.fileno())

    try:
        # Alternate screen, hidden cursor, and all-motion mouse reporting make
        # any keyboard, click, scroll, or pointer movement dismiss immediately.
        sys.stdout.write(f"{ESC}?1049h{ESC}?25l{ESC}?1003h{ESC}?1006h{ESC}2J")
        sys.stdout.flush()
        started = time.monotonic()
        last_scene = -1
        last_phase = -1

        while running:
            if select.select([sys.stdin], [], [], 0.20)[0]:
                os.read(sys.stdin.fileno(), 128)
                break

            elapsed = time.monotonic() - started
            scene_index = int(elapsed // scene_seconds) % len(scenes)
            scene_age = elapsed % scene_seconds
            phase = 0 if reduced else int(elapsed)
            render_phase = phase if reduced or scene_age >= 1.25 else int(elapsed * 4)
            if scene_index == last_scene and render_phase == last_phase:
                continue

            width, height = shutil.get_terminal_size((120, 40))
            if not reduced and scene_age < 1.25:
                art = transition(width, height, scene_index, scene_age / 1.25)
            else:
                art = scenes[scene_index](width, height, phase, not reduced)
            chrome = hud(width, height, scene_index, scene_age, scene_seconds, phase, not reduced)
            sys.stdout.write(f"{ESC}H{ESC}2J{ESC}48;2;5;4;10m{chrome}{art}{ESC}0m")
            sys.stdout.flush()
            last_scene, last_phase = scene_index, render_phase
    finally:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, original)
        sys.stdout.write(f"{ESC}?1006l{ESC}?1003l{ESC}?25h{ESC}?1049l{ESC}0m")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
